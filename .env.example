COMPOSE_PROJECT_NAME=sozyv-ops

# Web interfaces bind to localhost by default. Put them behind a VPN or reverse proxy for remote access.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Demo defaults. Replace these values with the real Sozyv database connection on the server.
POSTGRES_HOST=demo-postgres
POSTGRES_PORT=5432
POSTGRES_DB=sozyv
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-database-password
POSTGRES_EXPORTER_USER=postgres
POSTGRES_EXPORTER_PASSWORD=replace-with-a-database-password

# The endpoint is probed from the blackbox-exporter container.
SOZYV_HEALTH_URL=http://demo-app:8080/api/v1/health
SOZYV_PUBLIC_URL=https://chat.company.example

# Production override: use the existing Sozyv Compose network and attachment volume names.
SOZYV_NETWORK_NAME=sozyv-ops
SOZYV_FILES_VOLUME=sozyv-ops-demo-files
SOZYV_CONFIG_DIR=./demo/config

BACKUP_DIR=./runtime/backups
METRICS_DIR=./runtime/metrics
RETENTION_DAYS=14
PRUNE_OLD_BACKUPS=false
BACKUP_MAX_AGE_HOURS=26

# Container names used by scripts/doctor.sh on the Docker host.
SOZYV_APP_CONTAINER=sozyv-app
SOZYV_POSTGRES_CONTAINER=sozyv-postgres
SOZYV_TURN_CONTAINER=sozyv-turn
SOZYV_FILES_VOLUME_NAME=sozyv-files

DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
MEMORY_WARNING_PERCENT=85
TLS_WARNING_DAYS=14
